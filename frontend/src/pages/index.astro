---
import "../styles.css";
import Navbar from '../components/menu.astro'
import Footer from '../components/ppagina.astro'
import AnimatedText from '../components/AnimatedText.jsx';
import WaveBackground from '../components/WaveBackground.jsx';
import LoginModal from '../components/login.astro';
---

<!DOCTYPE html>
<html lang="es" >
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Visualización de redes LoRa con LoRaVIEW</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Geist&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
  <meta name="description" content="Dashboard de Red LoRa para diseñar la cobertura y rendimiento mediante mapas de calor, de forma simulada y con sondeo de datos.">
  <meta name="keywords" content="LoRa, IoT, Dashboard, Mapa de Calor, Redes, Diseño, Bolivia, Cochabamba">
  <meta name="author" content="Pol Alexander Ballesteros Quiroga">
  <meta property="og:title" content="Dashboard de Red LoRa Cochabamba">
  <meta property="og:description" content="Visualiza la cobertura y rendimiento de las redes LoRa en Cochabamba, Bolivia.">
  <script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = stored || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      // Sugerencia al navegador para colores de formularios/scrollbars
      document.documentElement.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
    } catch (e) {}
  })();
</script>

</head>


<body>
  <Navbar />
  <div class="wave-container position-relative">
    <WaveBackground client:load />
    <div class="inicio" style="color: #585858;">
      <div class="container-fluid" style="text-align:start; width: 80%; margin-top: 15dvw;">
        <h3>BIENVENIDO A</h3> 
        <h1 class="mb-2">
          <img src="../src/layouts/BannerLoRa.png" alt="LoRaVIEW" class="img-fluid d-block mx-0">
          </h1>
          <h2 class="fw-semibold"> <AnimatedText client:load /> de redes LoRa</h2>
      </div>
      <div class="container px-3 my-3">
        <a class="button mx-auto mx-md-0" role="button" data-bs-toggle="modal" data-bs-target="#exampleModal">
          <span>Empezar</span>
          <div class="icon">
            <i class="fa fa-user-circle"></i>
          </div>
        </a>
      </div>
    </div>
  </div>
  <div class="container text-center px-3 px-md-4">
    <div class="info-box mt-4" style="margin-bottom: 1rem;">
        <h5>¿Qué es LoRaVIEW? </h5>
        <p>LoRaVIEW es una plataforma web interactiva que permite visualizar y analizar la cobertura y calidad de redes LoRa. A través de sus herramientas LoRaMAP y LoRaTRACK, facilita la simulación y monitoreo de redes, optimizando su planificación y asegurando una conectividad eficiente en diversas zonas.</p>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
      <div class="col">
        <div class="card h-100 d-flex flex-column" onclick="openModal('resumen')">
          <img src="../src/layouts/LoRaMAP.png" class="card-img-top" alt="Vista general del proyecto de redes LoRa">
          <div class="card-body text-center">
            <h4 style="color: #1A8AF4;">LoRaMAP</h4>
            <p>Permite monitorear y analizar en datos reales de cobertura y rendimiento de redes LoRa.</p>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100 card--fixed-accent text-white text-center" style="align-items:center;">
          <img src="../src/layouts/LogoUnivalle.png" class="card-img-top" alt="Logo Univalle"
              style="width:60%; margin-top:20%; margin-bottom:20%;">
          <div class="card-body">
            <h4 style="color: #ffffff;">Información</h4>
            <p>Propiedad Intelectual e Información de Contacto.</p>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100">
          <img src="../src/layouts/LoRaTRACK.jpg" class="card-img-top" alt="Sonda de medición LoRa">
          <div class="card-body text-center">
            <h4 style="color: #1A8AF4;">LoRaTRACK</h4>
            <p>Permite simular y visualizar la cobertura de redes LoRa mediante mapas interactivos y modelos predictivos.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <Footer />
  <LoginModal client:load/>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
<style>
#animated-text {
  transition: opacity 600ms ease-in-out, color 600ms ease-in-out;
  display: inline-block;
}
.inicio { min-height: clamp(50vh, 70vh, 85vh); display:grid; place-items:center; padding: var(--space); }
.wave-container {width:100%; overflow-x:hidden;}
/* Reset */
@import url(//codepen.io/chrisdothtml/pen/ojLzJK.css);
/* Main Styles */
.button {
  display: block;
  background-color: #1A8AF4;
  width: min(80%, 15rem);
  height: clamp(3rem, 17.5vw, 3.75rem);
  line-height: 60px;
  color: #fff;
  position:relative;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  cursor: pointer;
  overflow: hidden;
  border-radius: 5px;
  box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.3);
  transition: all 0.25s cubic-bezier(0.31, -0.105, 0.43, 1.4);
}
.button span,
.button .icon {
  display: block;
  font-size: clamp(1rem, 2.5vw, 1.25rem);
  text-align: center;
  position: absolute;
  top: 0;
}
.button span {
  width: 72%;
  line-height: inherit;
  font-size: 22px;
  text-transform: uppercase;
  left: 0;
  transition: all 0.25s cubic-bezier(0.31, -0.105, 0.43, 1.4);
}
.button span:after {
  content: "";
  background-color: #485F75;
  width: 2px;
  height: 70%;
  position: absolute;
  top: 15%;
  right: -1px;
}
.button .icon {
  width: 28%;
  right: 0;
  transition: all 0.25s cubic-bezier(0.31, -0.105, 0.43, 1.4);
}
.button .icon .fa {
  font-size: 30px;
  vertical-align: middle;
  transition: all 0.25s cubic-bezier(0.31, -0.105, 0.43, 1.4), height 0.25s ease;
}
.button .icon .fa-remove {
  height: 36px;
}
.button .icon .fa-check {
  display: none;
}
.button.success span, .button:hover span {
  left: -72%;
  opacity: 0;
}
.button.success .icon, .button:hover .icon {
  width: 100%;
}
.button.success .icon .fa, .button:hover .icon .fa {
  font-size: 45px;
}
.button.success {
  background-color: #27ae60;
}
.button.success .icon .fa-remove {
  display: none;
}
.button.success .icon .fa-check {
  display: inline-block;
}
.button:hover {
  opacity: 0.9;
}
.button:hover .icon .fa-remove {
  height: 46px;
}
.button:active {
  opacity: 1;
}
</style>